# Optional provider layer. The assistant remains local unless Cloud is selected in the UI.
# Supported providers: groq, cerebras, openrouter, ollama, openai, custom.
TURBINEIQ_LLM_PROVIDER=groq
TURBINEIQ_LLM_API_KEY=
TURBINEIQ_LLM_MODEL=openai/gpt-oss-120b
TURBINEIQ_LLM_BASE_URL=https://api.groq.com/openai/v1
TURBINEIQ_LLM_TIMEOUT_SECONDS=30
TURBINEIQ_LLM_MAX_TOKENS=1200
TURBINEIQ_LLM_MAX_TOOL_ROUNDS=3

# Provider-specific fallbacks are also supported: GROQ_API_KEY, CEREBRAS_API_KEY,
# OPENROUTER_API_KEY, OLLAMA_API_KEY, OPENAI_API_KEY, and TURBINEIQ_CUSTOM_API_KEY.
# Hugging Face Router may use HF_TOKEN with provider=custom.

# Legacy OpenAI configuration remains supported when TURBINEIQ_LLM_PROVIDER is unset:
# OPENAI_API_KEY=
# TURBINEIQ_OPENAI_MODEL=gpt-5.5
# TURBINEIQ_OPENAI_BASE_URL=

